          }
        }
      ]
    },
    {
      "name": "Missing ID → 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/999999999",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
