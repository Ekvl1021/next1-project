            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students/{{studentId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{demoCode}}\",\n  \"firstName\": \"Болор\",\n  \"lastName\": \"Бат\",\n  \"email\": \"{{demoEmail}}\"\n}",
          "options": {
