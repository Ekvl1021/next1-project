PORT=3002
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:3001

# Comma-separated frontend origins; configure separately per environment.
CORS_ORIGINS=http://localhost:3001

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=universityDb
MONGODB_USERNAME=universityUser
MONGODB_PASSWORD=replace-with-a-random-password
MONGODB_AUTH_SOURCE=universityDb


MONGODB_CONNECT_ATTEMPTS=5
MONGODB_RETRY_DELAY_MS=2000

# Production: use the actual deployed frontend origin (no trailing slash).
# CORS_ORIGINS=https://your-project.vercel.app
# Cloud MongoDB alternative; overrides separate MONGODB_* connection fields:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/universityDb?authSource=admin
